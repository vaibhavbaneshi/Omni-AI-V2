APP_NAME=OmniAI
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

JWT_SECRET_KEY=dev-only-change-me-before-production
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# LLM provider: groq (production default) | openai | ollama (local dev)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_GEMMA_MODEL=gemma2-9b-it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Automatic model selection by mode/query (explicit model param still honored)
MODEL_ROUTING_ENABLED=true

# Optional — only when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
MODEL_NAME=llama3:latest

MAX_UPLOAD_BYTES=15728640
RATE_LIMIT_PER_MINUTE=120
# Use Redis sorted-set rate limiting when REDIS_URL is set (multi-worker safe).
ENABLE_REDIS_RATE_LIMIT=true
MAX_QUERY_CHARS=12000

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=OmniAI

# Persist API/model/token metrics to PostgreSQL (disable if DB unavailable)
ENABLE_USAGE_TRACKING=true

# Phase F — Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

CHAT_HISTORY_MESSAGE_LIMIT=8
CONVERSATION_SUMMARY_MIN_MESSAGES=6
CONVERSATION_SUMMARY_MAX_CHARS=4000

EVAL_ADMIN_EMAILS=
ANALYTICS_ADMIN_EMAILS=

# Auto-generate persisted document insights after indexing completes
ENABLE_DOCUMENT_INTELLIGENCE=false

# Phase B — rewrite follow-up queries and tune hybrid retrieval weights
ENABLE_QUERY_REWRITING=true
HYBRID_SEMANTIC_WEIGHT=0.65
HYBRID_BM25_WEIGHT=0.35

# Phase C — formal agent workflows (research reports + document analysis agent)
ENABLE_AGENT_WORKFLOWS=true
ENABLE_DEEP_RESEARCH=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Railway: set DATABASE_URL=${{Postgres.DATABASE_URL}} instead of individual POSTGRES_* vars
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omniai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=omniai_docs

# Document ingestion — API embeddings recommended for Railway (no PyTorch in prod image).
# local = pip install -r requirements-local-ml.txt (~1GB+ RAM)
# huggingface = HF Inference Providers API via router.huggingface.co (uses HF_TOKEN)
# openai = OpenAI embeddings API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=
HF_TOKEN=
ENABLE_LOCAL_ML=false
EMBEDDING_BATCH_SIZE=64
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=150
INGEST_MAX_CHUNKS=400
MAX_INGEST_TEXT_CHARS=600000
CHROMA_ADD_BATCH_SIZE=128
PRELOAD_EMBEDDING_MODEL=true
INGEST_IN_BACKGROUND=true
# Sprint 1 — durable ingestion (Redis + RQ). Requires worker: python -m app.worker
INGEST_QUEUE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
INGEST_JOB_MAX_RETRIES=3
INGEST_JOB_RETRY_INTERVALS=30,60,120
# Leave empty so each Railway container gets a unique worker name (recommended).
INGEST_WORKER_NAME=
ENABLE_RERANKER=true

ENABLE_DEEP_RESEARCH=false
ENABLE_MULTI_AGENT=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_GRAPH_RAG=true
ENABLE_RBAC=false
# Optional Neo4j sync (leave empty to use PostgreSQL + NetworkX only)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
