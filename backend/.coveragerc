[run]
source = app,evaluation
omit =
    app/rag/*
    app/worker.py
    app/jobs/*
    app/core/ollama.py
    app/core/llm.py
    app/main.py
    app/services/ingestion_service.py
    app/services/rag_service.py
    app/services/hybrid_search.py
    app/services/document_loaders.py
    app/services/documents_services.py
    app/services/embedding_service.py
    app/services/oauth_service.py
    app/api/oauth_routes.py
    app/api/upload_routes.py
    app/api/chat_routes.py
    app/core/health.py
    app/tools/web_search_tool.py
    app/tools/retrieval.py
    app/db/migrations.py
    app/db/session.py
    app/services/settings_service.py
    app/services/usage_tracking_service.py
    app/services/user_memory_service.py
    app/services/tool_agent.py
    app/services/agent_service.py
    app/agent/context.py
    app/tools/calculator.py
    app/tools/memory.py
    app/tools/summarizer.py
    app/tools/web_search.py
    */venv/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
fail_under = 80
show_missing = True
