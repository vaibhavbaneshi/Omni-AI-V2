# Railway production environment (set in Railway dashboard → Variables)

ENVIRONMENT=production
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_GEMMA_MODEL=gemma2-9b-it

# Optional — DeepSeek for coding routes (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Automatic model selection (set false to always use GROQ_MODEL)
MODEL_ROUTING_ENABLED=true

JWT_SECRET_KEY=<strong-32+-char-secret>
API_PUBLIC_URL=https://<your-backend>.up.railway.app
FRONTEND_URL=https://omni-ai-v2-frontend.vercel.app
CORS_ORIGINS=https://omni-ai-v2-frontend.vercel.app

# Preferred on Railway — single managed Postgres URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Migrations run automatically on backend startup (alembic upgrade head)

# Fallback if not using DATABASE_URL (Railway Postgres plugin references)
# POSTGRES_HOST=${{Postgres.PGHOST}}
# POSTGRES_PORT=${{Postgres.PGPORT}}
# POSTGRES_DB=${{Postgres.PGDATABASE}}
# POSTGRES_USER=${{Postgres.PGUSER}}
# POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}

CHROMA_DB_PATH=/data/chroma_db
COLLECTION_NAME=omniai_docs
UPLOAD_STAGING_DIR=/data/uploads

# --- Memory / RAG (Railway hobby plans are often 512MB–1GB) ---
# Production requirements.txt excludes PyTorch — use API embeddings (no local ML in RAM).
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PRELOAD_EMBEDDING_MODEL=false
ENABLE_RERANKER=false
ENABLE_LOCAL_ML=false
EMBEDDING_BATCH_SIZE=32
CHROMA_ADD_BATCH_SIZE=32
INGEST_MAX_CHUNKS=150
INGEST_IN_BACKGROUND=true

# Sprint 1 — Redis + RQ durable ingestion (requires ingest-worker service)
INGEST_QUEUE_ENABLED=true
REDIS_URL=${{Redis.REDIS_URL}}
INGEST_JOB_MAX_RETRIES=3
INGEST_JOB_RETRY_INTERVALS=30,60,120

# Alternative: OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=<your-openai-key>
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local PyTorch only with >=2GB RAM + pip install -r requirements-local-ml.txt:
# EMBEDDING_PROVIDER=local
# ENABLE_LOCAL_ML=true
# PRELOAD_EMBEDDING_MODEL=false
# ENABLE_RERANKER=false

# Mount a Railway volume at /data for Chroma persistence across deploys.

# Observability (optional — enable LangSmith for trace dashboards)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=OmniAI-Production
ENABLE_USAGE_TRACKING=true

# Comma-separated emails allowed to POST /evaluation/run in production
EVAL_ADMIN_EMAILS=

# OAuth (if used)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Do NOT set OLLAMA_URL on Railway unless running Ollama as a sidecar
# LLM_PROVIDER=groq is required for cloud deploys

# --- Railway start command (Settings → Deploy → Custom Start Command) ---
# Leave EMPTY to use Dockerfile CMD (API only). Do not use bare "cd ... &&" — Railway exec form has no shell.
# NEVER hardcode port 8000 — Railway injects $PORT. Dockerfile CMD uses ${PORT:-8000}.
# API + worker: sh -c "python -m app.worker & exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"

# --- Railway networking (Settings → Networking → Public Domain) ---
# If curl returns 502 but deploy logs show "Uvicorn running on 0.0.0.0:8080",
# the domain TARGET PORT is wrong. Set it to match PORT (check logs), e.g. 8080 — NOT 8000.
# Leave target port empty/auto if unsure. Enable Public Networking on the service.
# Use /health/live (instant). Do NOT use /health?deep=true — Postgres/Chroma probes can timeout (504).
# railway.toml in repo root sets healthcheckPath=/health/live automatically when detected.
